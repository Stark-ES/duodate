// DuoDate Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum Gender {
  M
  F
}

enum MatchType {
  V
  F
  R
  C
}

enum GameType {
  LOL
  TFT
  OW
  PUBG
}

enum MatchStatus {
  CHATTING_5MIN
  DECIDING
  VOICE_1HOUR
  EXPIRED
  LINKED
  CANCELED
}

enum InteractionType {
  LIKE
  PASS
}

enum QueueStatus {
  WAITING
  MATCHED
  CANCELED
  EXPIRED
}

// ============================================
// Models
// ============================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String    @map("password_hash")
  nickname             String
  gender               Gender
  birthDate            DateTime? @map("birth_date")
  
  // Profile
  profileImageUrl      String?   @map("profile_image_url")
  location             String?
  mbti                 String?
  hobby                String?
  bio                  String?
  
  // Game Info
  favoriteGame         GameType? @map("favorite_game")
  gameTier             String?   @map("game_tier")
  gamePosition         String?   @map("game_position")
  
  // Discord
  discordId            String?   @unique @map("discord_id")
  discordUsername      String?   @map("discord_username")
  discordLinkedAt      DateTime? @map("discord_linked_at")
  
  // Type
  myType               MatchType? @map("my_type")
  preferredType        MatchType? @map("preferred_type")
  
  // Stats
  totalMatches         Int       @default(0) @map("total_matches")
  totalLikesSent       Int       @default(0) @map("total_likes_sent")
  totalLikesReceived   Int       @default(0) @map("total_likes_received")
  mutualLikes          Int       @default(0) @map("mutual_likes")
  
  // Currency
  freeLikesToday       Int       @default(1) @map("free_likes_today")
  paidLikes            Int       @default(0) @map("paid_likes")
  
  // Status
  isActive             Boolean   @default(true) @map("is_active")
  isVerified           Boolean   @default(false) @map("is_verified")
  lastActiveAt         DateTime? @map("last_active_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tags                 UserTag[]
  matchesAsA           Match[]   @relation("UserA")
  matchesAsB           Match[]   @relation("UserB")
  sentInteractions     Interaction[] @relation("FromUser")
  receivedInteractions Interaction[] @relation("ToUser")
  linkedAsA            LinkedUser[] @relation("LinkedUserA")
  linkedAsB            LinkedUser[] @relation("LinkedUserB")
  chatMessages         ChatMessage[]
  queues               MatchingQueue[]
  payments             Payment[]
  reportsMade          UserReport[] @relation("Reporter")
  reportsReceived      UserReport[] @relation("Reported")

  @@map("users")
}

model UserTag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tag       String
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_tags")
}

model MatchingQueue {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  game      GameType
  type      MatchType
  status    QueueStatus @default(WAITING)
  position  Int?
  queuedAt  DateTime    @default(now()) @map("queued_at")
  matchedAt DateTime?   @map("matched_at")
  expiredAt DateTime?   @map("expired_at")
  
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, status])
  @@index([game, type, status, queuedAt])
  @@map("matching_queue")
}

model Match {
  id                   String      @id @default(uuid())
  matchCode            String      @unique @map("match_code")
  userAId              String      @map("user_a_id")
  userBId              String      @map("user_b_id")
  game                 GameType
  matchType            MatchType   @map("match_type")
  status               MatchStatus @default(CHATTING_5MIN)
  
  // Chat Decision
  userAChatDecision    Boolean?    @map("user_a_chat_decision")
  userBChatDecision    Boolean?    @map("user_b_chat_decision")
  chatStartedAt        DateTime?   @map("chat_started_at")
  chatEndedAt          DateTime?   @map("chat_ended_at")
  
  // Voice
  voiceStartedAt       DateTime?   @map("voice_started_at")
  voiceEndedAt         DateTime?   @map("voice_ended_at")
  
  // Discord
  discordVoiceChannelId String?    @map("discord_voice_channel_id")
  discordTextChannelId  String?    @map("discord_text_channel_id")
  
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  
  // Relations
  userA                User        @relation("UserA", fields: [userAId], references: [id])
  userB                User        @relation("UserB", fields: [userBId], references: [id])
  interactions         Interaction[]
  linkedUser           LinkedUser?
  chatMessages         ChatMessage[]
  discordRoom          DiscordRoom?

  @@index([userAId, userBId])
  @@index([status])
  @@map("matches")
}

model Interaction {
  id           String          @id @default(uuid())
  matchId      String          @map("match_id")
  fromUserId   String          @map("from_user_id")
  toUserId     String          @map("to_user_id")
  interaction  InteractionType
  isPaid       Boolean         @default(false) @map("is_paid")
  createdAt    DateTime        @default(now()) @map("created_at")
  
  match        Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromUser     User            @relation("FromUser", fields: [fromUserId], references: [id])
  toUser       User            @relation("ToUser", fields: [toUserId], references: [id])

  @@unique([matchId, fromUserId])
  @@index([toUserId])
  @@map("interactions")
}

model LinkedUser {
  id              String   @id @default(uuid())
  matchId         String   @unique @map("match_id")
  userAId         String   @map("user_a_id")
  userBId         String   @map("user_b_id")
  profileShared   Boolean  @default(true) @map("profile_shared")
  locationShared  Boolean  @default(true) @map("location_shared")
  contactShared   Boolean  @default(false) @map("contact_shared")
  linkedAt        DateTime @default(now()) @map("linked_at")
  
  match           Match    @relation(fields: [matchId], references: [id])
  userA           User     @relation("LinkedUserA", fields: [userAId], references: [id])
  userB           User     @relation("LinkedUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@map("linked_users")
}

model ChatMessage {
  id          String   @id @default(uuid())
  matchId     String   @map("match_id")
  senderId    String   @map("sender_id")
  messageType String   @default("text") @map("message_type")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id])

  @@index([matchId, createdAt])
  @@map("chat_messages")
}

model IcebreakerMessage {
  id          String     @id @default(uuid())
  messageType String     @map("message_type")
  matchType   MatchType? @map("match_type")
  game        GameType?
  icon        String?
  content     String
  optionA     String?    @map("option_a")
  optionB     String?    @map("option_b")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([messageType, matchType, game])
  @@map("icebreaker_messages")
}

model DiscordRoom {
  id             String   @id @default(uuid())
  matchId        String   @unique @map("match_id")
  voiceChannelId String   @map("voice_channel_id")
  textChannelId  String   @map("text_channel_id")
  serverId       String   @map("server_id")
  deepLink       String?  @map("deep_link")
  webLink        String?  @map("web_link")
  isActive       Boolean  @default(true) @map("is_active")
  userAJoined    Boolean  @default(false) @map("user_a_joined")
  userBJoined    Boolean  @default(false) @map("user_b_joined")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  deletedAt      DateTime? @map("deleted_at")
  
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([isActive, expiresAt])
  @@map("discord_rooms")
}

model UserReport {
  id          String    @id @default(uuid())
  reporterId  String    @map("reporter_id")
  reportedId  String    @map("reported_id")
  matchId     String?   @map("match_id")
  reason      String
  description String?
  status      String    @default("pending")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @map("reviewed_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  reporter    User      @relation("Reporter", fields: [reporterId], references: [id])
  reported    User      @relation("Reported", fields: [reportedId], references: [id])

  @@index([reportedId])
  @@map("user_reports")
}

model Payment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  amount          Int
  currency        String    @default("KRW")
  productType     String    @map("product_type")
  productQuantity Int       @default(1) @map("product_quantity")
  paymentMethod   String?   @map("payment_method")
  paymentProvider String?   @map("payment_provider")
  externalId      String?   @map("external_id")
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("payments")
}
